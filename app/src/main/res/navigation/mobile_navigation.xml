<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.tectest.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_cash"
        android:name="com.example.tectest.ui.cash.CashFragment"
        android:label="@string/title_cash"
        tools:layout="@layout/fragment_cash" />

    <fragment
        android:id="@+id/navigation_task"
        android:name="com.example.tectest.ui.task.TaskFragment"
        android:label="@string/title_task"
        tools:layout="@layout/fragment_task" />

    <fragment
        android:id="@+id/navigation_notes"
        android:name="com.example.tectest.ui.notes.NotesFragment"
        android:label="@string/title_notes"
        tools:layout="@layout/fragment_notes" >
        <action
            android:id="@+id/action_notesFragment_to_folderDetailFragment"
            app:destination="@id/folderDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/folderDetailFragment"
        android:name="com.example.tectest.ui.notes.FolderDetailFragment"
        android:label="{folderName}"
        tools:layout="@layout/fragment_folder_detail" >
        <argument
            android:name="folderId"
            app:argType="string" />
        <argument
            android:name="folderName"
            app:argType="string" />
        <action
            android:id="@+id/action_folderDetailFragment_to_addEditNoteFragment"
            app:destination="@id/addEditNoteFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEditNoteFragment"
        android:name="com.example.tectest.ui.notes.AddEditNoteFragment"
        android:label="{noteTitleArg}"
        tools:layout="@layout/fragment_add_edit_note" >
    <argument
        android:name="folderId"
        app:argType="string" />
    <argument
        android:name="noteId"
        app:argType="string"
        app:nullable="true"
        android:defaultValue="@null" />
    <argument
        android:name="noteTitleArg"
        app:argType="string"
        android:defaultValue="New Note" />
    </fragment>

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.tectest.ui.profile.ProfileFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_navigation_profile_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.tectest.ui.profile.EditProfileFragment"
        android:label="Edit Profile"
        tools:layout="@layout/fragment_edit_profile" />
</navigation>